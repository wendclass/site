# ==============================================================================
# VARIABLES D'ENVIRONNEMENT — SITE OFFICIEL CLASS S
# ==============================================================================
# ATTENTION AUX PRÉFIXES :
# Les variables préfixées par VITE_ sont injectées dans le code JavaScript envoyé au
# navigateur de tous les visiteurs. N'y mettez JAMAIS de clés secrètes !
#
# Les variables SANS préfixe VITE_ sont purement serveur et doivent être renseignées
# dans Vercel (Project Settings > Environment Variables) pour les Serverless Functions.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VARIABLES FRONT-END / CLIENT (Publiques, injectées au build)
# ------------------------------------------------------------------------------
# URL publique du projet Supabase
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique anonyme Supabase (anon key)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Email de l'administrateur autorisé (Google OAuth)
VITE_ADMIN_ALLOWED_EMAIL=wendclasss@gmail.com

# Clé de site Cloudflare Turnstile (Site Key - publique)
# À récupérer sur le tableau de bord Cloudflare Turnstile (gratuit)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...

# ------------------------------------------------------------------------------
# 2. VARIABLES SERVEUR VERCEL (Secrètes, JAMAIS exposées au client)
# ------------------------------------------------------------------------------
# À renseigner sur le tableau de bord Vercel > Settings > Environment Variables

# Clé secrète de service Supabase (Service Role Key)
# Permet au endpoint /api/contact d'insérer les demandes de manière sécurisée
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé secrète Cloudflare Turnstile (Secret Key)
# Permet au endpoint /api/contact de vérifier la validité du token anti-bot
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Base Redis Upstash pour le Rate Limiting distribué (anti-spam / anti-brute force)
# Créer une base Serverless Redis gratuite sur upstash.com
UPSTASH_REDIS_REST_URL=https://votre-cluster.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# Clé API Resend pour l'envoi des notifications par email à Scott
RESEND_API_KEY=re_...
