{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/classs(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://images.unsplash.com https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self';"
        }
      ]
    }
  ],
  "functions": {
    "api/ssr.js": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/googlebea468e8e5719358.html",
      "destination": "/api/google-verify"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/ssr?route=/blog/:slug&slug=:slug"
    },
    {
      "source": "/blog",
      "destination": "/api/ssr?route=/blog"
    },
    {
      "source": "/offres",
      "destination": "/api/ssr?route=/offres"
    },
    {
      "source": "/projets",
      "destination": "/api/ssr?route=/projets"
    },
    {
      "source": "/a-propos",
      "destination": "/api/ssr?route=/a-propos"
    },
    {
      "source": "/",
      "destination": "/api/ssr?route=/"
    },
    {
      "source": "/classs(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/((?!api/|assets/|favicon|sitemap\\.xml|robots\\.txt|googlebea468e8e5719358\\.html|classs).*)",
      "destination": "/api/ssr?route=/$1"
    }
  ]
}
